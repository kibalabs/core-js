{
  "name": "@kibalabs/core",
  "version": "0.7.1",
  "description": "Utilities for use in front-end projects at Kiba Labs (plain, React and Web3)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibalabs/core-js.git"
  },
  "homepage": "https://github.com/kibalabs/core-js",
  "bugs": "https://github.com/kibalabs/core-js/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./web3": {
      "types": "./dist/web3/index.d.ts",
      "import": "./dist/web3/index.js",
      "default": "./dist/web3/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/*"
  ],
  "dependencies": {
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "deepmerge": "^4.3.1",
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@base-org/account": "2.6.0",
    "@kibalabs/build": "0.14.2-next.17",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-ethers": "1.8.24",
    "@safe-global/safe-apps-provider": "0.18.6",
    "@safe-global/safe-apps-sdk": "9.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ethers": "6.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "peerDependencies": {
    "@base-org/account": "^2.5.13",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-ethers": "^1.8.24",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "ethers": "^6.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.5.0"
  },
  "peerDependenciesMeta": {
    "@base-org/account": {
      "optional": true
    },
    "@reown/appkit": {
      "optional": true
    },
    "@reown/appkit-adapter-ethers": {
      "optional": true
    },
    "@safe-global/safe-apps-provider": {
      "optional": true
    },
    "@safe-global/safe-apps-sdk": {
      "optional": true
    },
    "ethers": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  }
}
